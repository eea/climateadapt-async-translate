PORT=3000
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASS=
PORTAL_URL=http://localhost:8080/cca
TRANSLATION_AUTH_TOKEN=hello1234

# Queues this process monitors and jobs it is allowed to run.
# etranslation_submit is only needed when ETL_GROUPING_ENABLED=true.
# translation_failed consumes eTranslation's failure notification, forwarded by
# @@translate-failure. Deploy the worker BEFORE the Plone change that starts
# sending it: if the job name is absent from ENABLED_JOBS the worker rejects the
# job with RateLimitError and retries it immediately, i.e. a busy loop.
BULL_QUEUE_NAMES_CSV=etranslation,save_etranslation,sync_paths,delete_translation,etranslation_submit
ENABLED_JOBS=call_etranslation,save_translated_html,sync_translated_paths,delete_translation,submit_group,translation_failed

# ---- quota-aware eTranslation submissions -------------------------------
# Master switch. Leave off until the Plone change that accepts a comma
# separated target_lang + ext_ref on @@call-etranslation and forwards
# targetLanguage from @@translate-callback is deployed.
ETL_GROUPING_ENABLED=false
ETL_GROUP_WINDOW_MS=10000
ETL_GROUP_TTL_SEC=3600

# eTranslation allows 50 active submissions per client (errorCode=-11200
# QUOTA_EXCEEDED above that). Keep headroom for anything else sharing the
# account.
ETL_MAX_INFLIGHT=40
# With failure notifications working, a submission is resolved by an event
# rather than a timeout, so this can drop to 2-3 minutes once a staging sweep
# confirms notifications arrive. Keep it at 15 minutes until then.
ETL_LEASE_MS=900000
ETL_BREAKER_MS=30000

ETL_SKIP_CACHE=true
ETL_SKIP_CACHE_TTL_SEC=604800
ETL_CORR_TTL_SEC=86400
ETL_STALE_JOB_MAX_AGE_MS=604800
ETL_SUBMIT_QUEUE=etranslation_submit
